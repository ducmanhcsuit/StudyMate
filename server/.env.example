DATABASE_URL="postgresql://studymate:studymate@localhost:5432/studymate"
PORT=3000
AI_SERVICE_URL="http://localhost:8000"
INTERNAL_KEY="doi-chuoi-nay-va-dat-giong-trong-ai/.env"

# Khóa ký JWT, ít nhất 32 ký tự; để trống thì server không khởi động. Sinh khóa bằng lệnh:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Tài khoản Admin đầu tiên, dùng khi chạy: npx prisma db seed (mật khẩu ít nhất 8 ký tự)
ADMIN_EMAIL="admin@studymate.local"
ADMIN_PASSWORD=""

# production thì cookie đăng nhập có thêm thuộc tính Secure
NODE_ENV="development"
